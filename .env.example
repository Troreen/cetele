# Public Supabase project facts. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Required to create an Auth user only after a valid manual invitation is claimed.
SUPABASE_SECRET_KEY=
CETELE_APP_ORIGIN=http://127.0.0.1:3000

# Set to "supabase" only after the hosted verification gate passes.
NEXT_PUBLIC_CETELE_DATA_ADAPTER=local

# Disposable hosted-verification identities. Keep values in .env.local only.
CETELE_VERIFY_SUBJECT_EMAIL=
CETELE_VERIFY_SUBJECT_PASSWORD=
CETELE_VERIFY_DIRECT_EMAIL=
CETELE_VERIFY_DIRECT_PASSWORD=
CETELE_VERIFY_SENIOR_EMAIL=
CETELE_VERIFY_SENIOR_PASSWORD=
CETELE_VERIFY_PEER_EMAIL=
CETELE_VERIFY_PEER_PASSWORD=
CETELE_VERIFY_OUTSIDER_EMAIL=
CETELE_VERIFY_OUTSIDER_PASSWORD=
