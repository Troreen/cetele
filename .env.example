# Public Supabase project facts. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Required for invite delivery and explicitly bounded account administration.
SUPABASE_SECRET_KEY=
CETELE_APP_ORIGIN=http://127.0.0.1:3000

# Signup remains blocked unless this is explicitly enabled in a non-production environment.
# Database deployment_controls must also be explicitly enabled. Production
# activation additionally requires approved legal copy and hosted Auth abuse-control review.
CETELE_ALLOW_NON_PRODUCTION_SIGNUP=false

# Cleanup is dry-run by default and refuses any project except this explicit disposable ref.
CETELE_DISPOSABLE_PROJECT_REF=
CETELE_PRODUCTION_PROJECT_REF=
CETELE_CLEANUP_EXECUTE=false
CETELE_DELETION_EXECUTE=false
CETELE_VERIFY_AUTH_INVITE=false

# Set to "supabase" only after the hosted verification gate passes.
NEXT_PUBLIC_CETELE_DATA_ADAPTER=local

# Disposable hosted-verification identities. Keep values in .env.local only.
CETELE_VERIFY_SUBJECT_EMAIL=
CETELE_VERIFY_SUBJECT_PASSWORD=
CETELE_VERIFY_DIRECT_EMAIL=
CETELE_VERIFY_DIRECT_PASSWORD=
CETELE_VERIFY_SENIOR_EMAIL=
CETELE_VERIFY_SENIOR_PASSWORD=
CETELE_VERIFY_PEER_EMAIL=
CETELE_VERIFY_PEER_PASSWORD=
CETELE_VERIFY_OUTSIDER_EMAIL=
CETELE_VERIFY_OUTSIDER_PASSWORD=
