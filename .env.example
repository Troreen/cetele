# Public Supabase project facts. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Required only for mentorship invitations and hosted verification.
SUPABASE_SECRET_KEY=
CETELE_APP_ORIGIN=http://127.0.0.1:3000

# Set to "supabase" only after the hosted verification gate passes.
NEXT_PUBLIC_CETELE_DATA_ADAPTER=local
