{
  "name": "cetele",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "prepare:hosted": "node scripts/prepare-hosted-verification.mjs",
    "verify:hosted": "node --env-file-if-exists=.env.local scripts/verify-hosted-supabase.mjs",
    "cleanup:incomplete": "node --env-file-if-exists=.env.local scripts/cleanup-incomplete-accounts.mjs",
    "process:deletions": "node --env-file-if-exists=.env.local scripts/process-account-deletions.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prototype:daily": "node prototypes/daily-view/server.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
